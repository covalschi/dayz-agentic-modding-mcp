FrameWidgetClass MyMod_FilterMenu {
 position 0 0
 size 520 420
 halign center_ref
 valign center_ref
 hexactpos 1
 vexactpos 1
 hexactsize 1
 vexactsize 1
 priority 998
 {
  PanelWidgetClass Background {
   ignorepointer 1
   color 0.09 0.09 0.09 0.92
   position 0 0
   size 1 1
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   priority 1
   style rover_sim_colorable
  }
  TextWidgetClass Title {
   ignorepointer 1
   color 1 1 1 1
   position 16 12
   size 488 28
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   priority 2
   text "Select an item"
   font "gui/fonts/sdf_MetronBook24"
   "exact text" 1
   "exact text size" 18
   "text halign" left
   "text valign" center
  }
