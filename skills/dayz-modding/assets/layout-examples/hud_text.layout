//               return;
//           m_MyMod_HudValue = TextWidget.Cast(m_MyMod_HudRoot.FindAnyWidget("Value"));
//       }
//
//       void MyMod_SetHudValue(string text)
//       {
//           if (!m_MyMod_HudValue || text == m_MyMod_HudShown)
//               return;
//           m_MyMod_HudShown = text;
//           m_MyMod_HudValue.SetText(text);
//       }
//
