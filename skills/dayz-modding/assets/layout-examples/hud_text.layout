FrameWidgetClass MyMod_HudText {
 ignorepointer 1
 clipchildren 0
 position 24 120
 size 200 50
 hexactpos 1
 vexactpos 1
 hexactsize 1
 vexactsize 1
 priority 1
 {
  TextWidgetClass Title {
   ignorepointer 1
   color 0.8 0.8 0.8 0.9
   position 0 0
   size 200 22
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   text "Title"
   font "gui/fonts/sdf_MetronBook24"
   "exact text" 1
   "exact text size" 13
   "text halign" left
   "text valign" center
   "outline size" 1
   "outline color" 0 0 0 0.6
  }
  TextWidgetClass Value {
   ignorepointer 1
   color 1 1 1 1
   position 0 22
   size 200 28
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   text "0"
   font "gui/fonts/sdf_MetronBook24"
   "exact text" 1
   "exact text size" 18
   "text halign" left
   "text valign" center
   "outline size" 1
   "outline color" 0 0 0 0.6
  }
 }
}
