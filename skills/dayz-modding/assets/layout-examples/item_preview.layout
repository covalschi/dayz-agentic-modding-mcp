FrameWidgetClass MyMod_ItemPreview {
 position 0 0
 size 420 440
 halign center_ref
 valign center_ref
 hexactpos 1
 vexactpos 1
 hexactsize 1
 vexactsize 1
 priority 200
 {
  PanelWidgetClass Background {
   ignorepointer 1
   color 0.09 0.09 0.09 0.92
   position 0 0
   size 1 1
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   priority 1
   style rover_sim_colorable
  }
  TextWidgetClass Title {
   ignorepointer 1
   color 1 1 1 1
   position 16 12
   size 388 28
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   priority 2
   text "Item"
   font "gui/fonts/sdf_MetronBook24"
   "exact text" 1
   "exact text size" 18
   "text halign" left
   "text valign" center
  }
  ItemPreviewWidgetClass Preview {
   ignorepointer 1
   clipchildren 1
   position 16 48
   size 388 330
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   priority 2
  }
  ButtonWidgetClass BtnRotateLeft {
   position 16 392
   size 124 32
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   priority 3
   style Empty
   userID 1
   {
    PanelWidgetClass RotateLeftBg {
     ignorepointer 1
     color 0.28 0.28 0.28 1
     position 0 0
     size 1 1
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     priority 1
     style rover_sim_colorable
    }
    TextWidgetClass RotateLeftCaption {
     ignorepointer 1
     color 1 1 1 1
     position 0 0
     size 1 1
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     priority 2
     text "Rotate left"
     font "gui/fonts/sdf_MetronBook24"
     "exact text" 1
     "exact text size" 15
     "text halign" center
     "text valign" center
    }
   }
  }
  ButtonWidgetClass BtnRotateRight {
   position 148 392
   size 124 32
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   priority 3
   style Empty
   userID 2
   {
    PanelWidgetClass RotateRightBg {
     ignorepointer 1
     color 0.28 0.28 0.28 1
     position 0 0
     size 1 1
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     priority 1
     style rover_sim_colorable
    }
    TextWidgetClass RotateRightCaption {
     ignorepointer 1
     color 1 1 1 1
     position 0 0
     size 1 1
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     priority 2
     text "Rotate right"
     font "gui/fonts/sdf_MetronBook24"
     "exact text" 1
     "exact text size" 15
     "text halign" center
     "text valign" center
    }
   }
  }
  ButtonWidgetClass BtnClose {
   position 280 392
   size 124 32
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   priority 3
   style Empty
   userID 3
   {
    PanelWidgetClass CloseBg {
     ignorepointer 1
     color 0.28 0.28 0.28 1
     position 0 0
     size 1 1
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     priority 1
